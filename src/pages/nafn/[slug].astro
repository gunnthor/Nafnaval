---
import Base from '../../layouts/Base.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import Sparkline from '../../components/Sparkline.astro';
import arAxis from '../../data/ar.json';
import { CATEGORY_BY_SLUG } from '../../lib/categories.ts';
import { HJARTA } from '../../lib/hjarta.ts';
import { slugify, collator, tala } from '../../lib/icelandic.ts';
import nofn from '../../data/nofn.json';
import type { NameEntry } from '../../lib/types.ts';

export async function getStaticPaths() {
  const entries = (await import('../../data/nofn.json')).default as NameEntry[];
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

interface Props {
  entry: NameEntry & { skyring?: string };
}

const { entry } = Astro.props;
const all = nofn as Array<NameEntry & { skyring?: string }>;

const TYPE_LABEL: Record<string, string> = {
  ST: 'Stúlkunafn',
  DR: 'Drengjanafn',
  MI: 'Millinafn',
  KH: 'Kynhlutlaust nafn',
  RST: 'Ritbreyting stúlkunafns',
  RDR: 'Ritbreyting drengjanafns',
};

const STATUS_LABEL: Record<string, string> = {
  Sam: 'Samþykkt af mannanafnanefnd',
  Haf: 'Hafnað af mannanafnanefnd',
  Óaf: 'Óafgreitt hjá mannanafnanefnd',
};

/**
 * Names sharing an element. This is the exploration loop.
 *
 * Ordered by how many people actually bear them, NOT alphabetically. Sorting
 * A–Ö and then cutting to 24 meant every list was Aðal-, Arn-, Ás- and nothing
 * else; the commonest name sharing the element could be invisible.
 */
const elementIds = entry.lidir.map((l) => l.lidur).filter(Boolean) as string[];

const related = elementIds.length
  ? all
      .filter(
        (e) =>
          e.slug !== entry.slug &&
          e.status === 'Sam' &&
          !e.erRitbreyting &&
          e.lidir.some((l) => l.lidur && elementIds.includes(l.lidur)),
      )
      .sort((a, b) => {
        const d = (b.vinsaeldir?.alls ?? 0) - (a.vinsaeldir?.alls ?? 0);
        return d !== 0 ? d : collator.compare(a.nafn, b.nafn);
      })
      .slice(0, 24)
  : [];

/** Spelling variants that point at this name. */
const variants = all.filter((e) => e.erRitbreyting && e.ritbreytingAf === entry.slug);

/** For a variant, the name it defers to. */
const parent = entry.erRitbreyting && entry.ritbreytingAf
  ? all.find((e) => e.slug === entry.ritbreytingAf)
  : undefined;

const pop = entry.vinsaeldir;

const description = entry.merking
  ? `${entry.nafn}: ${entry.merking}. ${TYPE_LABEL[entry.type] ?? ''}, ${STATUS_LABEL[entry.status ?? ''] ?? ''}.`
  : `${entry.nafn} er ${(TYPE_LABEL[entry.type] ?? 'nafn').toLowerCase()} í íslenskri mannanafnaskrá.`;
---

<Base title={entry.nafn} description={description}>
  <div class="wrap">
    <div class="name-hero">
      <h1>{entry.nafn}</h1>
      <p class="meta">
        {TYPE_LABEL[entry.type]}
        {entry.status && <> · {STATUS_LABEL[entry.status]}</>}
        {entry.verdict && <> · úrskurður {entry.verdict}</>}
      </p>

      {
        entry.status === 'Sam' && (
          <p style="margin:0.85rem 0 0">
            <button class="vista vista-stor" type="button" data-vista={entry.slug} aria-pressed="false">
              <Fragment set:html={HJARTA} />
              <span class="vista-texti">Setja á listann</span>
            </button>
          </p>
        )
      }

      {
        entry.merking ? (
          <>
            <p class="meaning">
              {entry.merking} <TrustBadge confidence={entry.confidence} />
            </p>
            {entry.skyring && <p class="skyring">{entry.skyring}</p>}
            {entry.confidence === 'ostadfest' && (
              <p class="notice">
                Þessi skýring er tekin saman af gervigreind eftir leit á vefnum og hefur
                ekki verið yfirfarin af nafnfræðingi.
                {entry.aiHeimild ? (
                  <>
                    {' '}Hún byggir á{' '}
                    <a href={entry.aiHeimild} rel="nofollow noopener" target="_blank">
                      {entry.aiHeimildTitill || 'þessari heimild'}
                    </a>. Flettu henni upp ef nafnið skiptir þig máli.
                  </>
                ) : (
                  <> Hún gæti verið röng.</>
                )}{' '}
                <a href="/um#areidanleiki">Nánar um áreiðanleika</a>.
              </p>
            )}
          </>
        ) : (
          <p class="notice">
            Merking þessa nafns er ekki skráð hjá okkur enn.
            {parent && (
              <> Sjá <a href={`/nafn/${parent.slug}`}>{parent.nafn}</a>.</>
            )}
          </p>
        )
      }
    </div>

    {
      entry.lidir.length > 0 && (
        <section class="card">
          {/* A one-element name is not a compound. It *is* the element. */}
          <h2>{entry.lidir.length > 1 ? 'Nafnið er sett saman úr' : 'Nafnið er dregið af'}</h2>
          <div class="lidir">
            {entry.lidir.map((seg, i) => (
              <>
                {i > 0 && <span class="plus" aria-hidden="true">+</span>}
                {seg.lidur ? (
                  <a class="lidur" href={`/lidur/${slugify(seg.lidur)}`}>
                    <span class="texti">{seg.lidur}</span>
                    <span class="gloss">{seg.merking}</span>
                    {seg.heimild && <span class="heimild">Heimild: {seg.heimild}</span>}
                  </a>
                ) : (
                  <span class="lidur">
                    <span class="texti">{seg.texti}</span>
                  </span>
                )}
              </>
            ))}
          </div>
        </section>
      )
    }

    {
      entry.beyging && (
        <section class="card">
          <h2>Beyging</h2>
          <table class="beyging">
            <tbody>
              <tr><th>Nefnifall</th><td>hér er {entry.beyging.nefnifall}</td></tr>
              <tr><th>Þolfall</th><td>um {entry.beyging.tholfall}</td></tr>
              <tr><th>Þágufall</th><td>frá {entry.beyging.thagufall}</td></tr>
              <tr><th>Eignarfall</th><td>til {entry.beyging.eignarfall}</td></tr>
            </tbody>
          </table>
        </section>
      )
    }

    {
      pop && (
        <section class="card">
          <h2>Hversu margir heita þetta?</h2>
          <div class="pop-grid">
            <div class="pop-figure">
              <span class="n">{tala(pop.fjoldi)}</span>
              <span class="k">bera það sem eiginnafn</span>
            </div>
            <div class="pop-figure">
              <span class="n">{tala(pop.fjoldiAnnad)}</span>
              <span class="k">sem annað nafn</span>
            </div>
            <div class="pop-figure">
              <span class="n">{tala(pop.alls)}</span>
              <span class="k">alls á Íslandi</span>
            </div>
            {pop.saeti != null && (
              <div class="pop-figure">
                <span class="n">{pop.saeti}.</span>
                <span class="k">
                  sæti af {tala(pop.afFjolda ?? 0)}
                  {entry.gender === 'kvk' ? ' kvenmannsnöfnum' : entry.gender === 'kk' ? ' karlmannsnöfnum' : ''}
                </span>
              </div>
            )}
          </div>

          {pop.ferill.some((v) => v > 0) && (
            <>
              <Sparkline gildi={pop.ferill} ar={arAxis as number[]} label={`Fjöldi sem ber nafnið ${entry.nafn} sem eiginnafn, ${arAxis[0]}–${arAxis[arAxis.length - 1]}`} />
              {pop.breyting != null && (
                <p style="margin:0.5rem 0 0">
                  <span
                    class={`delta ${pop.breyting > 3 ? 'delta-up' : pop.breyting < -3 ? 'delta-down' : 'delta-flat'}`}
                  >
                    {pop.breyting > 0 ? '↑' : pop.breyting < 0 ? '↓' : '→'}{' '}
                    {Math.abs(pop.breyting)}%
                  </span>{' '}
                  <span class="skyring" style="font-size:0.85rem">á síðustu tíu árum</span>
                </p>
              )}
            </>
          )}

          <p class="skyring" style="font-size:0.78rem;margin-top:0.7rem">
            Tölur frá Þjóðskrá Íslands, miðaðar við skráð lögheimili.
          </p>
        </section>
      )
    }

    {
      entry.flokkar.length > 0 && (
        <section class="card">
          <h2>Flokkar</h2>
          <ul class="tag-list">
            {entry.flokkar.map((f) => {
              const cat = CATEGORY_BY_SLUG.get(f);
              return cat ? (
                <li><a class="tag" href={`/flokkur/${cat.slug}`}>{cat.heiti}</a></li>
              ) : null;
            })}
          </ul>
        </section>
      )
    }

    {
      variants.length > 0 && (
        <section class="card">
          <h2>Leyfðar ritbreytingar</h2>
          <ul class="tag-list">
            {variants.map((v) => (
              <li><a class="tag" href={`/nafn/${v.slug}`}>{v.nafn}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="card">
          <h2>Skyld nöfn</h2>
          <p class="skyring" style="margin-bottom:0.7rem">
            Nöfn sem deila lið með {entry.nafn}, algengustu fyrst.
          </p>
          <div class="related-grid">
            {related.map((r) => (
              <a class="related-item" href={`/nafn/${r.slug}`}>
                <span class="n">{r.nafn}</span>
                <span class="c">
                  {r.vinsaeldir ? `${tala(r.vinsaeldir.alls)} bera það` : 'enginn skráður'}
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
