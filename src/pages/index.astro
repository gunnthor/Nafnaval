---
import Base from '../layouts/Base.astro';
import { GROUP_LABELS, childrenOf, topLevelIn } from '../lib/categories.ts';
import { HJARTA } from '../lib/hjarta.ts';
import { tala } from '../lib/icelandic.ts';
import nofn from '../data/nofn.json';
import type { NameEntry } from '../lib/types.ts';

const entries = nofn as NameEntry[];
const browsable = entries.filter((e) => e.status === 'Sam' && !e.erRitbreyting);

/** First screenful, server-rendered so the page works with JS disabled. */
const initial = browsable.slice(0, 100);

const groups = ['nattura', 'folk', 'eiginleikar', 'hagnytt'] as const;
const byGroup = groups.map((g) => ({
  slug: g,
  heiti: GROUP_LABELS[g],
  // Only top-level categories here; children (the faiths) render nested
  // beneath their parent so the hierarchy is visible rather than implied.
  // Kynhlutlaus is rendered in the Kyn group instead, so drop it here.
  categories: topLevelIn(g)
    .filter((c) => c.slug !== 'kynhlutlaust')
    .map((c) => ({ ...c, born: childrenOf(c.slug) })),
}));

const withMeaning = browsable.filter((e) => e.merking).length;
---

<Base
  berTitill
  title="Íslensk mannanöfn: merking, uppruni og vinsældir"
  description={`Merking og uppruni ${browsable.length} íslenskra mannanafna. Leitaðu, síaðu eftir flokkum og grafðu þig niður í liðina sem nöfnin eru byggð úr.`}
>
  <div class="wrap">
    <div class="hero">
      <h1>Merking og uppruni íslenskra mannanafna</h1>
      <p>
        Öll <strong>{tala(browsable.length)} nöfnin</strong> í íslenskri
        mannanafnaskrá, með merkingu þeirra, liðunum sem þau eru byggð úr,
        beygingunni og fjölda þeirra sem bera þau í dag.
      </p>
    </div>
  </div>

  <div class="searchbar">
    <div class="wrap">
      <label class="visually-hidden" for="q">Leita að nafni</label>
      <input
        id="q"
        type="search"
        placeholder="Leitaðu að nafni eða merkingu…"
        autocomplete="off"
        enterkeyhint="search"
      />
      <button class="btn filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filters">
        Síur
      </button>
    </div>
  </div>

  <div class="wrap">
    <div class="layout">
      <div class="filters-backdrop" id="filters-backdrop"></div>
      <aside class="filters" id="filters" aria-label="Síur">
        <div class="filters-head">
          <h2>Síur</h2>
          <button class="sheet-close" type="button" id="close-filters" aria-label="Loka síum">×</button>
        </div>
        <p class="skyring" style="font-size:0.8rem;margin:0 0 0.9rem">
          Smelltu einu sinni til að <strong>hafa með</strong>, tvisvar til að
          <strong>sleppa</strong>, þrisvar til að slökkva.
        </p>
        <p class="skyring" style="font-size:0.8rem;margin:0 0 1rem">
          Innan hvers hóps nægir að nafn passi við <strong>eina</strong> síu.
          Vatn og Veður sýnir því nöfn sem tengjast öðru hvoru. Milli hópa þarf allt að passa.
        </p>

        {/*
          Kyn goes first, because it is what most people narrow by before anything
          else, and on mobile the sheet still scrolls, so position matters.

          Kynhlutlaus is a category chip, not a third gender chip, on purpose:
          millinöfn also carry gender "hlutlaust", so a gender-based chip would
          lump 219 middle names in with the 43 names the register actually
          marks KH. The category means exactly one thing.
        */}
        <div class="filter-group">
          <h3>Kyn</h3>
          <div class="chips">
            <button class="chip" type="button" data-kyn="kvk" data-hopur="kyn">Kvenmannsnöfn</button>
            <button class="chip" type="button" data-kyn="kk" data-hopur="kyn">Karlmannsnöfn</button>
            <button class="chip" type="button" data-flokkur="kynhlutlaust" data-hopur="kyn" title="Nöfn skráð kynhlutlaus í mannanafnaskrá">
              Kynhlutlaus
            </button>
          </div>
        </div>
        {
          byGroup.map((group) => (
            <div class="filter-group">
              <h3>{group.heiti}</h3>
              <div class="chips">
                {group.categories
                  .filter((c) => c.born.length === 0)
                  .map((c) => (
                    <button class="chip" type="button" data-flokkur={c.slug} data-hopur={group.slug} title={c.lysing}>
                      {c.heiti}
                    </button>
                  ))}
              </div>
              {group.categories
                .filter((c) => c.born.length > 0)
                .map((c) => (
                  <div style="margin-top:0.5rem">
                    <div class="chips">
                      <button class="chip" type="button" data-flokkur={c.slug} data-hopur={group.slug} title={c.lysing}>
                        {c.heiti}
                      </button>
                    </div>
                    <div class="chips chips-nested">
                      {c.born.map((b) => (
                        <button class="chip" type="button" data-flokkur={b.slug} data-hopur={group.slug} title={b.lysing}>
                          {b.heiti}
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
            </div>
          ))
        }
        <button class="btn" type="button" id="clear-filters">Hreinsa síur</button>

        {/* Mobile only: without this the sheet covers the very results it filters. */}
        <button class="btn btn-primary sheet-apply" type="button" id="apply-filters">
          Sýna niðurstöður
        </button>
      </aside>

      <div>
        <div class="active-filters" id="active-filters" hidden>
          <span class="label">Virkar síur:</span>
        </div>

        <div class="sortbar">
          <span class="label">Raða eftir:</span>
          <span class="seg" role="group" aria-label="Röðun">
            <button type="button" id="sort-vinsaeldir" aria-pressed="true">Vinsældum</button>
            <button type="button" id="sort-stafrof" aria-pressed="false">Stafrófi</button>
          </span>
        </div>

        <p class="result-count" id="count" data-total={browsable.length}>
          {tala(browsable.length)} nöfn, þar af {tala(withMeaning)} með skráða merkingu
        </p>

        <ul class="name-list" id="results">
          {
            initial.map((e) => (
              <li>
                <a href={`/nafn/${e.slug}`}>
                  <span class="gender">{e.gender === 'kvk' ? 'kvk' : e.gender === 'kk' ? 'kk' : '—'}</span>
                  <span class="nafn">{e.nafn}</span>
                  <span class="merking">{e.merking ?? ''}</span>
                  <span class="fjoldi">{e.vinsaeldir ? tala(e.vinsaeldir.alls) : ''}</span>
                  <button class="vista" type="button" data-vista={e.slug} aria-pressed="false" aria-label="Setja á listann" set:html={HJARTA} />
                </a>
              </li>
            ))
          }
        </ul>

        <p class="empty" id="empty" hidden>Ekkert nafn fannst. Prófaðu aðra leit eða færri síur.</p>
        <p style="padding:1rem 0">
          <button class="btn" type="button" id="more" hidden>Sýna fleiri</button>
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { fold, collator, tala } from '../lib/icelandic.ts';
  import { CATEGORY_BY_SLUG } from '../lib/categories.ts';
  import { HJARTA } from '../lib/hjarta.ts';
  import { tengjaHnappa, tengjaTeljara, samstillaHnappa } from '../lib/listi.ts';

  interface Row {
    n: string; // nafn
    s: string; // slug
    g: 'kvk' | 'kk' | 'hlutlaust';
    l: string; // folded name, for search
    f: string[]; // flokkar
    m: string; // merking
    c: string; // confidence
    v: number; // popularity rank, 0 = none
  }

  /** off → include → exclude → off */
  type State = 'inc' | 'exc';

  const PAGE = 200;

  const q = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results') as HTMLUListElement;
  const count = document.getElementById('count') as HTMLParagraphElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;
  const more = document.getElementById('more') as HTMLButtonElement;
  const filters = document.getElementById('filters') as HTMLElement;
  const backdrop = document.getElementById('filters-backdrop') as HTMLElement;
  const toggle = document.getElementById('filter-toggle') as HTMLButtonElement;
  const clear = document.getElementById('clear-filters') as HTMLButtonElement;
  const activeBar = document.getElementById('active-filters') as HTMLElement;

  let rows: Row[] = [];
  let matches: Row[] = [];
  let shown = 0;
  /** Default to popularity: an A–Ö list buries every name people know. */
  let sortBy: 'vinsaeldir' | 'stafrof' = 'vinsaeldir';

  /** slug -> include/exclude. Absent means the filter is off. */
  const categories = new Map<string, State>();
  const genders = new Map<string, State>();

  const GENDER_LABEL: Record<string, string> = { kvk: 'kvk', kk: 'kk', hlutlaust: '—' };
  const GENDER_NAME: Record<string, string> = {
    kvk: 'Kvenmannsnöfn',
    kk: 'Karlmannsnöfn',
    hlutlaust: 'Kynhlutlaus',
  };
  const labelFor = (slug: string) => CATEGORY_BY_SLUG.get(slug)?.heiti ?? GENDER_NAME[slug] ?? slug;

  function render(reset: boolean) {
    if (reset) {
      results.replaceChildren();
      shown = 0;
    }
    const slice = matches.slice(shown, shown + PAGE);
    const frag = document.createDocumentFragment();
    for (const r of slice) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/nafn/${r.s}`;

      const g = document.createElement('span');
      g.className = 'gender';
      g.textContent = GENDER_LABEL[r.g] ?? '—';

      const n = document.createElement('span');
      n.className = 'nafn';
      n.textContent = r.n;

      const m = document.createElement('span');
      m.className = 'merking';
      m.textContent = r.m;

      const c = document.createElement('span');
      c.className = 'fjoldi';
      c.textContent = r.v > 0 ? tala(r.v) : '';
      c.title = r.v > 0 ? `${tala(r.v)} bera nafnið` : '';

      const save = document.createElement('button');
      save.type = 'button';
      save.className = 'vista';
      save.dataset.vista = r.s;
      // Painted here rather than left to samstillaHnappa so the row never
      // renders one frame tall and then grows once the heart lands in it.
      save.innerHTML = HJARTA;

      a.append(g, n, m, c, save);
      li.append(a);
      frag.append(li);
    }
    results.append(frag);
    shown += slice.length;

    more.hidden = shown >= matches.length;
    empty.hidden = matches.length > 0;
    count.textContent =
      matches.length === rows.length
        ? `${tala(rows.length)} nöfn`
        : `${tala(matches.length)} af ${tala(rows.length)} nöfnum`;
    const apply = document.getElementById('apply-filters');
    if (apply) apply.textContent = `Sýna ${tala(matches.length)} nöfn`;
    samstillaHnappa();
  }

  /** The always-visible summary of what is currently filtering the list. */
  function renderActive() {
    const pills: Array<{ kind: 'flokkur' | 'kyn'; slug: string; state: State }> = [
      ...[...categories].map(([slug, state]) => ({ kind: 'flokkur' as const, slug, state })),
      ...[...genders].map(([slug, state]) => ({ kind: 'kyn' as const, slug, state })),
    ];

    activeBar.replaceChildren();
    if (pills.length === 0 && !q.value) {
      activeBar.hidden = true;
      return;
    }
    activeBar.hidden = false;

    const label = document.createElement('span');
    label.className = 'label';
    label.textContent = 'Virkar síur:';
    activeBar.append(label);

    if (q.value) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pill pill-inc';
      b.innerHTML = `„${escapeHtml(q.value)}“ <span class="x" aria-hidden="true">×</span>`;
      b.setAttribute('aria-label', `Hreinsa leitina „${q.value}“`);
      b.addEventListener('click', () => {
        q.value = '';
        apply();
      });
      activeBar.append(b);
    }

    for (const p of pills) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `pill pill-${p.state}`;
      const prefix = p.state === 'exc' ? 'Ekki ' : '';
      b.innerHTML = `${escapeHtml(prefix + labelFor(p.slug))} <span class="x" aria-hidden="true">×</span>`;
      b.setAttribute('aria-label', `Fjarlægja síuna ${prefix}${labelFor(p.slug)}`);
      b.addEventListener('click', () => {
        (p.kind === 'flokkur' ? categories : genders).delete(p.slug);
        syncChips();
        apply();
      });
      activeBar.append(b);
    }

    const all = document.createElement('button');
    all.type = 'button';
    all.className = 'link-btn';
    all.textContent = 'Hreinsa allt';
    all.addEventListener('click', clearAll);
    activeBar.append(all);
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  /** Which visual group each chip belongs to, read straight from the markup. */
  const facetOf = new Map<string, string>();
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.chip[data-hopur]')) {
    const slug = btn.dataset.flokkur ?? btn.dataset.kyn;
    if (slug) facetOf.set(slug, btn.dataset.hopur!);
  }

  function apply() {
    const needle = fold(q.value);
    const excCats = [...categories].filter(([, v]) => v === 'exc').map(([k]) => k);
    const excGen = [...genders].filter(([, v]) => v === 'exc').map(([k]) => k);

    /**
     * Selections are grouped by facet: within one group the filters are an OR,
     * across groups an AND. Picking Vatn and Veður means "either", not "both":
     * ANDing them returned 48 names where the union is 667, and nobody picking
     * two kinds of nature wants the intersection.
     *
     * Gender and Kynhlutlaus share the `kyn` facet, so those three OR together
     * too, even though gender matches a row's `g` and the category its `f`.
     */
    const inc = new Map<string, { cats: string[]; kyn: string[] }>();
    const slot = (facet: string) =>
      inc.get(facet) ?? inc.set(facet, { cats: [], kyn: [] }).get(facet)!;
    for (const [slug, state] of categories) {
      if (state === 'inc') slot(facetOf.get(slug) ?? 'annad').cats.push(slug);
    }
    for (const [g, state] of genders) {
      if (state === 'inc') slot(facetOf.get(g) ?? 'kyn').kyn.push(g);
    }

    matches = rows.filter((r) => {
      if (needle && !r.l.includes(needle) && !fold(r.m).includes(needle)) return false;
      // Exclusions stay strict: excluding two things means neither.
      for (const c of excCats) if (r.f.includes(c)) return false;
      if (excGen.includes(r.g)) return false;
      for (const sel of inc.values()) {
        const hit =
          sel.cats.some((c) => r.f.includes(c)) || sel.kyn.some((g) => g === r.g);
        if (!hit) return false;
      }
      return true;
    });

    if (needle) {
      matches.sort((a, b) => {
        const ap = a.l.startsWith(needle) ? 0 : 1;
        const bp = b.l.startsWith(needle) ? 0 : 1;
        if (ap !== bp) return ap - bp;
        return sortBy === 'vinsaeldir' ? b.v - a.v || collator.compare(a.n, b.n) : collator.compare(a.n, b.n);
      });
    } else if (sortBy === 'vinsaeldir') {
      matches.sort((a, b) => b.v - a.v || collator.compare(a.n, b.n));
    } else {
      matches.sort((a, b) => collator.compare(a.n, b.n));
    }

    render(true);
    renderActive();
    persist();
  }

  /** Reflect state in the URL so a filtered view can be shared or bookmarked. */
  function persist() {
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    const inc = [...categories].filter(([, v]) => v === 'inc').map(([k]) => k);
    const exc = [...categories].filter(([, v]) => v === 'exc').map(([k]) => k);
    const kinc = [...genders].filter(([, v]) => v === 'inc').map(([k]) => k);
    const kexc = [...genders].filter(([, v]) => v === 'exc').map(([k]) => k);
    if (inc.length) p.set('f', inc.join(','));
    if (exc.length) p.set('x', exc.join(','));
    if (kinc.length) p.set('k', kinc.join(','));
    if (kexc.length) p.set('kx', kexc.join(','));
    const s = p.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  function restore() {
    const p = new URLSearchParams(location.search);
    q.value = p.get('q') ?? '';
    const load = (param: string, map: Map<string, State>, state: State) => {
      for (const s of (p.get(param) ?? '').split(',').filter(Boolean)) map.set(s, state);
    };
    load('f', categories, 'inc');
    load('x', categories, 'exc');
    load('k', genders, 'inc');
    load('kx', genders, 'exc');
    syncChips();
  }

  function syncChips() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.chip')) {
      const slug = btn.dataset.flokkur ?? btn.dataset.kyn!;
      const map = btn.dataset.flokkur ? categories : genders;
      const state = map.get(slug);
      if (state) btn.dataset.state = state;
      else delete btn.dataset.state;
      const label = labelFor(slug);
      btn.setAttribute(
        'aria-label',
        state === 'inc'
          ? `${label}: haft með. Smelltu til að sleppa.`
          : state === 'exc'
            ? `${label}: sleppt. Smelltu til að slökkva.`
            : `${label}: engin sía. Smelltu til að hafa með.`,
      );
    }
  }

  function clearAll() {
    categories.clear();
    genders.clear();
    q.value = '';
    syncChips();
    apply();
    closeFilters();
  }

  let timer: number;
  q.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(apply, 120);
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.chip')) {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.flokkur ?? btn.dataset.kyn!;
      const map = btn.dataset.flokkur ? categories : genders;
      const now = map.get(slug);
      if (!now) map.set(slug, 'inc');
      else if (now === 'inc') map.set(slug, 'exc');
      else map.delete(slug);
      syncChips();
      apply();
    });
  }

  const sortButtons = {
    vinsaeldir: document.getElementById('sort-vinsaeldir') as HTMLButtonElement,
    stafrof: document.getElementById('sort-stafrof') as HTMLButtonElement,
  };
  for (const [key, btn] of Object.entries(sortButtons)) {
    btn.addEventListener('click', () => {
      sortBy = key as typeof sortBy;
      for (const [k, b] of Object.entries(sortButtons)) {
        b.setAttribute('aria-pressed', k === key ? 'true' : 'false');
      }
      apply();
    });
  }

  clear.addEventListener('click', clearAll);
  more.addEventListener('click', () => render(false));
  document.getElementById('close-filters')!.addEventListener('click', closeFilters);
  document.getElementById('apply-filters')!.addEventListener('click', closeFilters);

  function openFilters() {
    filters.dataset.open = 'true';
    backdrop.dataset.open = 'true';
    toggle.setAttribute('aria-expanded', 'true');
  }
  function closeFilters() {
    delete filters.dataset.open;
    delete backdrop.dataset.open;
    toggle.setAttribute('aria-expanded', 'false');
  }
  toggle.addEventListener('click', () =>
    toggle.getAttribute('aria-expanded') === 'true' ? closeFilters() : openFilters(),
  );
  backdrop.addEventListener('click', closeFilters);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeFilters();
  });

  tengjaTeljara();
  tengjaHnappa();

  fetch('/leit.json')
    .then((r) => r.json())
    .then((data: Row[]) => {
      rows = data;
      restore();
      apply();
    })
    .catch(() => {
      count.textContent = 'Ekki tókst að hlaða leitarskrá. Sýni fyrstu 100 nöfnin.';
    });
</script>
